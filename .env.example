# WorkPilot AI configuration. Copy to .env for a local run; never commit .env.
# REQUIRED  = needed for that mode   OPTIONAL = enables a feature
# FALLBACK  = what happens when it is not set
#
# Zero-credential local demo: leave DEMO_MODE=true. Everything runs in memory with
# deterministic, clearly labelled fallbacks (no Gemini, Firestore or Google calls).

# --- Mode -----------------------------------------------------------------------
DEMO_MODE=true                      # false = use Google Cloud (Cloud Run sets false)

# --- Google Cloud core (REQUIRED when DEMO_MODE=false) --------------------------
GOOGLE_CLOUD_PROJECT=               # your project id
GOOGLE_CLOUD_LOCATION=global        # Gemini on Vertex AI location
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=TRUE      # read by the google-genai SDK
ADK_ENABLED=true                    # FALLBACK when false/unavailable: deterministic pipeline, labelled

# --- Firestore: sessions, decisions, actions, audit trail (REQUIRED for persistence) -
FIRESTORE_ENABLED=true              # FALLBACK: in-memory store (lost on restart)
WORKPILOT_WORKSPACE=builder-cup-demo  # namespace inside Firestore

# --- Vertex AI Search / Agent Search (OPTIONAL) ---------------------------------
# Create with scripts/bootstrap_cloud.py. FALLBACK: local TF-IDF retrieval, labelled.
VERTEX_SEARCH_ENABLED=false
VERTEX_SEARCH_LOCATION=global
VERTEX_SEARCH_DATA_STORE_ID=workpilot-knowledge
VERTEX_SEARCH_ENGINE_ID=workpilot-search

# --- Document AI OCR for uploaded PDFs and images (OPTIONAL) --------------------
# Processor id is printed by scripts/bootstrap_cloud.py. FALLBACK: local parsers.
DOCUMENT_AI_ENABLED=false
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=

# --- BigQuery event analytics (OPTIONAL) ----------------------------------------
# FALLBACK: events are still written to the Firestore audit trail.
BIGQUERY_ENABLED=false
BIGQUERY_DATASET=workpilot
BIGQUERY_TABLE=events
BIGQUERY_LOCATION=US

# --- Gmail drafts / Calendar events for approved actions (OPTIONAL) -------------
# Needs a user OAuth token from scripts/authorize_workspace_oauth.py, stored in Secret
# Manager and mounted by deploy-cloud-run.sh. Never put the token in this file.
# FALLBACK: Approval's run buttons are disabled and actions stay "Not started".
EXECUTION_ENABLED=true
WORKPILOT_OAUTH_TOKEN_JSON=
WORKPILOT_OAUTH_TOKEN_FILE=
WORKPILOT_OWNER_EMAIL_DOMAIN=example.com   # draft recipients: <owner>@this-domain
WORKPILOT_OWNER_EMAILS=                    # optional map, e.g. "Mei=mei@example.com;Arjun=arjun@example.com"

# --- Impact formula assumptions (OPTIONAL; shown in the app's methodology) ------
IMPACT_READING_WPM=200
IMPACT_MINUTES_PER_ACTION=5
IMPACT_MINUTES_PER_FOLLOWUP=5
IMPACT_MINUTES_PER_DECISION=10
IMPACT_MINUTES_PER_BLOCKER=10
IMPACT_MINUTES_PER_OWNER=15
IMPACT_WINDOW_DAYS=7
